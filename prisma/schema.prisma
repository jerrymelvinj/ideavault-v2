// Prisma Schema for IdeaVault Phase 3 (PostgreSQL for Vercel & Supabase)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  createdAt          DateTime            @default(now())
  preferences        String?             // Stored as JSON string
  knowledgeItems     KnowledgeItem[]
  categories         Category[]
  tags               Tag[]
  projects           Project[]
  insights           AIInsight[]
  cognitiveSnapshots CognitiveSnapshot[]
}

model KnowledgeItem {
  id               String               @id @default(uuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  rawContent       String
  summary          String?
  contentType      String               @default("Idea") // Idea, Note, Project, Research, Draft, Reference, Observation, Question
  status           String               @default("Active") // Active, InProgress, Archived, Unfinished, Abandoned
  source           String               @default("Direct") // Direct, GoogleDocs, Notion, TXT, PDF, OCR, WhatsApp, Telegram, Voice
  projectId        String?
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  embedding        String?              // Vector embedding stored as JSON float array string
  structuredData   String?              // Extra AI insights/development/evaluation stored as JSON
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tags             KnowledgeItemTag[]
  sourceItemRel    Relationship[]       @relation("SourceRelationship")
  targetItemRel    Relationship[]       @relation("TargetRelationship")
  versions         Version[]
  sources          Source[]
}

model Category {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  knowledgeItems KnowledgeItem[]
}

model Tag {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String             @unique
  knowledgeItems KnowledgeItemTag[]
}

model KnowledgeItemTag {
  itemId String
  tagId  String
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model Relationship {
  id               String        @id @default(uuid())
  sourceItemId     String
  targetItemId     String
  sourceItem       KnowledgeItem @relation("SourceRelationship", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItem       KnowledgeItem @relation("TargetRelationship", fields: [targetItemId], references: [id], onDelete: Cascade)
  relationshipType String        // Similar, Related, EvolvesFrom, Contradicts, Supports, PartOf, InspiredBy
  confidence       Float         @default(0.8)
  reason           String?
  createdAt        DateTime      @default(now())
}

model Version {
  id            String        @id @default(uuid())
  itemId        String
  item          KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  content       String
  changeSummary String?
  createdAt     DateTime      @default(now())
}

model Project {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String          @default("Active") // Active, Completed, Paused
  milestones     String?         // Stored as JSON string
  roadmap        String?         // Stored as JSON string
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt @default(now())
  knowledgeItems KnowledgeItem[]
  tasks          ProjectTask[]
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("ToDo") // ToDo, InProgress, Done
  priority    String   @default("Medium") // High, Medium, Low
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CognitiveSnapshot {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period              String   // e.g. "2026-Q3"
  topicDistribution   String   // JSON string of category percentages
  velocity            Int      @default(0)
  convergingInsights  String?  // JSON string of forecasted convergences
  strategicAdvice     String?
  createdAt           DateTime @default(now())
}

model Source {
  id          String        @id @default(uuid())
  itemId      String
  item        KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceType  String        // GoogleDocs, Notion, TXT, PDF, OCR, WhatsApp, Telegram, Voice
  externalId  String?
  originalUrl String?
  importedAt  DateTime      @default(now())
}

model AIInsight {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String    // Connection, Rediscover, Pattern, Unfinished, Revisit, Forecast
  content        String
  relatedItemIds String?   // JSON array of item IDs
  confidence     Float     @default(0.85)
  createdAt      DateTime  @default(now())
  dismissedAt    DateTime?
}
